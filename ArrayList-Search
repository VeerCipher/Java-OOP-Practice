package searcharraylist;
import java.util.ArrayList;

public class SearchArrayList 
{

    public static void main(String[] args) 
    {
        ArrayList <String> Students = new ArrayList <> ();
        
            // Adding Elements
            
        Students.add("Jalali");
        Students.add("Junaid");
        Students.add("Ahsan");
        Students.add("Ali");
        Students.add("Hamza");
        
        String search = "Jalali";
        System.out.printf("Student List  :  %s\n", Students);
        
        if(Students.contains(search))
        {
            System.out.printf("%s is found\n",search);
        }
        else
        {
            System.out.printf("%s is not found", search);
        }
    }
    
}
